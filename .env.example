# Secrets accept a <NAME>_FILE variant that is read from a mounted file and
# takes precedence over <NAME>. A configured but unreadable or empty file is a
# startup error rather than a fallback.

APP_ENV=

DISCORD_TOKEN=
DISCORD_TOKEN_FILE=

GOOGLE_API_KEY=
GOOGLE_API_KEY_FILE=
AI_BASE_PROMPT=

SCAM_DETECT_ENABLED=true
SCAM_DETECT_QUEUE_CAPACITY=128
SCAM_DETECT_WORKERS=2
SCAM_DETECT_MAX_IMAGES_PER_MESSAGE=3
SCAM_DETECT_MAX_UPLOAD_MB=10
SCAM_DETECT_DOWNLOAD_TIMEOUT_SECS=10
SCAM_DETECT_SCAN_TIMEOUT_SECS=30
SCAM_DETECT_JOB_TTL_SECS=120
SCAM_DETECT_MAX_IMAGE_WIDTH=1600
SCAM_DETECT_MAX_DECODED_PIXELS=16777216
SCAM_DETECT_OCR_TEXT_LIMIT=3000
SCAM_DETECT_OCR_MIN_CHARS_FOR_PSM6=20
SCAM_DETECT_OCR_MAX_CONCURRENT=1
SCAM_DETECT_BLOCK_THRESHOLD=0.80
SCAM_DETECT_REVIEW_THRESHOLD=0.55
SCAM_DETECT_TESSERACT_LANG=eng
SCAM_DETECT_TESSDATA_DIR=

REDIS_URL=redis://redis:6379

MONGO_URI=mongodb://mongo:27017
MONGO_USERNAME=homestead
MONGO_PASSWORD=secret
MONGO_PASSWORD_FILE=
MONGO_AUTH_SOURCE=admin
MONGO_DATABASE=develop
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_SSL=false
MONGO_TLS_CA_FILE=
MONGO_TLS_CERT_KEY_FILE=
MONGO_TLS_INSECURE=
